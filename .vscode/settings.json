{
    "python.analysis.extraPaths": ["plugins", "packages/client/src", "packages/framework/src"],
    "python.analysis.include": ["plugins"],
    "ruff.lint.ignore": ["I001"],
    "autocorrect.enable": false,
    "autocorrect.enableLint": false,
    "autocorrect.formatOnSave": false,
    "files.associations": {
        "justfile": "plaintext"
    },
    "search.useIgnoreFiles": false,
    "search.exclude": {
        ".env": true,
        "*.log": true,
        "config_and_data_files": true
    }
}
